---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Catalog from "./_components/catalog/index.astro";
import { catalog, type CatalogEntry } from "./_components/catalog/catalog";

export function getStaticPaths() {
  return [
    { params: { component: undefined }, props: { entry: null } },
    { params: { component: "examples" }, props: { entry: null, examples: true } },
    ...catalog.map((entry) => ({ params: { component: entry.slug }, props: { entry } })),
  ];
}
interface Props { entry: CatalogEntry | null; examples?: boolean }
const { entry, examples = false } = Astro.props;
---
<BaseLayout title={examples ? "Examples · OhMyGUI" : entry ? entry.name + " · OhMyGUI" : "OhMyGUI · The component library"} description={examples ? "Example usage of this library" : entry?.description ?? "Explore every OhMyGUI component with an example and copyable source."}>
  <Catalog entry={entry} examples={examples} />
</BaseLayout>

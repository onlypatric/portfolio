---
import type { BlogPost, BlogPostKey } from '../../../_contracts/common/blog/posts';
import WhyAIIsntDesigningMySystems from './articles/why-ai-isnt-designing-my-systems.astro';
import ModernUX from './articles/modern-ux.astro';

const articles = {
  'why-ai-isnt-designing-my-systems': WhyAIIsntDesigningMySystems,
  'modern-ux': ModernUX
} satisfies Record<BlogPostKey, typeof WhyAIIsntDesigningMySystems>;

interface Props { post: BlogPost }
const { post } = Astro.props;
const Content = articles[post.key];
---
<div class="blog-page">
  <a class="skip-link" href="#article">Skip to article</a>
  <nav aria-label="Blog navigation"><a href="/#writing">← Writing</a><a href="mailto:patric@pintescul.com">Contact Patric ↗</a></nav>
  <main id="article">
    <article aria-labelledby="article-title">
      <header>
        <p class="topic">{post.topic}</p>
        <h1 id="article-title">{post.title}</h1>
        <p class="byline">Patric Pintescul{post.status === 'draft' && <span> · In progress</span>}</p>
      </header>
      <div class="article-body"><Content /></div>
    </article>
    <footer><a href="/#writing">← Back to Writing</a></footer>
  </main>
</div>

<style>
  .blog-page { min-height: 100vh; padding: 0 24px; background: radial-gradient(ellipse at 20% 0%, #b88d4818, transparent 650px), #201f1b; color: #f1ebdf; font-family: ui-sans-serif, system-ui, sans-serif; }
  nav { max-width: 1080px; margin-inline: auto; padding-block: 30px; border-bottom: 1px solid #3e3c33; display: flex; justify-content: space-between; gap: 24px; font-size: 13px; }
  a { color: #c4d59a; text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 5px; }
  a:focus-visible { outline: 2px solid #c4d59a; outline-offset: 5px; border-radius: 2px; }
  main { max-width: 720px; margin-inline: auto; padding-block: 76px 40px; }
  header { border-bottom: 1px solid #3e3c33; padding-bottom: 32px; margin-bottom: 38px; }
  .topic { color: #c4d59a; font: 11px ui-monospace, monospace; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 22px; }
  h1 { font-family: var(--font-serif); font-size: clamp(36px, 6vw, 58px); font-weight: 400; line-height: 1.12; letter-spacing: -1.8px; margin: 0; text-wrap: balance; }
  .byline { font-size: 13px; color: #b6b0a2; margin: 24px 0 0; }
  .article-body { font-size: 17px; line-height: 1.85; color: #ddd7ca; overflow-wrap: anywhere; }
  .article-body :global(p), .article-body :global(ul), .article-body :global(ol), .article-body :global(blockquote) { margin-block: 0 1.5em; }
  .article-body :global(h2), .article-body :global(h3) { color: #f1ebdf; line-height: 1.3; margin: 1.6em 0 .65em; font-family: var(--font-serif); font-weight: 400; }
  .article-body :global(h2) { font-size: 31px; }
  .article-body :global(h3) { font-size: 25px; }
  .article-body :global(a) { color: #c4d59a; text-decoration: underline; text-underline-offset: 4px; }
  .article-body :global(a:focus-visible) { outline: 2px solid #c4d59a; outline-offset: 4px; }
  .article-body :global(ul), .article-body :global(ol) { padding-left: 1.5em; }
  .article-body :global(ul) { list-style: disc; }
  .article-body :global(ol) { list-style: decimal; }
  .article-body :global(blockquote) { padding-left: 20px; border-left: 2px solid #859768; color: #b6b0a2; }
  .article-body :global(pre) { overflow-x: auto; max-width: 100%; padding: 20px; background: #2a2a22; border-radius: 12px; font-size: 14px; }
  .article-body :global(img), .article-body :global(video) { max-width: 100%; height: auto; border-radius: 12px; }
  footer { margin-top: 60px; padding-top: 24px; border-top: 1px solid #3e3c33; font-size: 13px; }
  .skip-link { position: fixed; top: -100px; left: 20px; padding: 12px; background: #c4d59a; color: #201f1b; z-index: 10; }
  .skip-link:focus { top: 12px; }
  @media (max-width: 540px) { main { padding-top: 46px; } nav { font-size: 12px; } .article-body { font-size: 16px; } }
</style>

---
import Portfolio from './Portfolio';
import './home.css';

// Optional art is resolved at build time; absent files keep the decorative fallback.
const artwork = import.meta.glob<string>('/src/assets/projects/*.{webp,png,jpg,jpeg,avif}', {
  eager: true,
  query: '?url',
  import: 'default',
});
const images = Object.fromEntries(Object.entries(artwork).map(([path, url]) => [
  path.split('/').pop()!.replace(/\.[^.]+$/, ''), url,
]));
---
<Portfolio images={images} year={new Date().getFullYear()} client:load />
